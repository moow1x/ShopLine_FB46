<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Restock" targetNamespace="https://shopline.local/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.30.1">
  <bpmn:collaboration id="Collab_Restock" name="Поповнення складу">
    <bpmn:participant id="PPS" name="Магазин" processRef="PS" />
    <bpmn:participant id="PA" name="Постачальник A" />
    <bpmn:participant id="PB" name="Постачальник B" />
    <bpmn:messageFlow id="PMA" name="Замовлення A" sourceRef="A7" targetRef="PA" />
    <bpmn:messageFlow id="PMA2" name="Відповідь A" sourceRef="PA" targetRef="A8" />
    <bpmn:messageFlow id="PMB" name="Замовлення B" sourceRef="B7" targetRef="PB" />
    <bpmn:messageFlow id="PMB2" name="Відповідь B" sourceRef="PB" targetRef="B8" />
    <bpmn:textAnnotation id="PAN">
      <bpmn:text>Постачальник A та B — умовні екземпляри; конкретні назви й кількість Каталогом не задані.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_PAN_P6" associationDirection="None" sourceRef="PAN" targetRef="P6" />
  </bpmn:collaboration>
  <bpmn:process id="PS" isExecutable="false">
    <bpmn:laneSet id="LaneSet_PS">
      <bpmn:lane id="PW" name="Склад">
        <bpmn:flowNodeRef>A10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B13</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PM" name="Менеджер">
        <bpmn:flowNodeRef>P5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PY" name="Система">
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B16</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P1" name="Залишок нижче мінімуму">
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">stockBelowMinimum=true</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="P2" name="Щотижнева перевірка">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle>R/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="P3" name="Об’єднання запуску" />
    <bpmn:task id="P4" name="Сформувати список дефіцитних позицій" />
    <bpmn:task id="P5" name="Розподілити позиції між постачальниками" />
    <bpmn:inclusiveGateway id="P6" name="Яким постачальникам надіслати замовлення?" />
    <bpmn:task id="A7" name="Надіслати замовлення постачальнику A" />
    <bpmn:intermediateCatchEvent id="A8" name="Отримано відповідь A">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="A10" name="Поставка A надійшла">
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">deliveryA=true</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="A11" name="Прийняти поставку A та звірити накладну" />
    <bpmn:exclusiveGateway id="A12" name="Є розбіжності A?" />
    <bpmn:task id="B7" name="Надіслати замовлення постачальнику B" />
    <bpmn:intermediateCatchEvent id="B10" name="Поставка B надійшла">
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">deliveryB=true</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="B11" name="Прийняти поставку B та звірити накладну" />
    <bpmn:exclusiveGateway id="B12" name="Є розбіжності B?" />
    <bpmn:dataObjectReference id="PDO" name="Список дефіцитних позицій" dataObjectRef="PDO_Data" />
    <bpmn:dataObject id="PDO_Data" />
    <bpmn:dataObjectReference id="POB" name="Замовлення постачальнику B" dataObjectRef="POB_Data" />
    <bpmn:dataObject id="POB_Data" />
    <bpmn:dataObjectReference id="INB" name="Накладна B" dataObjectRef="INB_Data" />
    <bpmn:dataObject id="INB_Data" />
    <bpmn:dataObjectReference id="POA" name="Замовлення постачальнику A" dataObjectRef="POA_Data" />
    <bpmn:dataObject id="POA_Data" />
    <bpmn:intermediateCatchEvent id="B8" name="Отримано відповідь B">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="A17" name="Постачальник A відмовив" />
    <bpmn:endEvent id="B17" name="Постачальник B відмовив" />
    <bpmn:exclusiveGateway id="A9" name="Постачальник A підтвердив?" />
    <bpmn:exclusiveGateway id="B9" name="Постачальник B підтвердив?" />
    <bpmn:dataObjectReference id="INA" name="Накладна A" dataObjectRef="INA_Data" />
    <bpmn:dataObject id="INA_Data" />
    <bpmn:exclusiveGateway id="B14" name="Об’єднання B" />
    <bpmn:exclusiveGateway id="A14" name="Об’єднання A" />
    <bpmn:task id="A13" name="Оформити рекламацію A" />
    <bpmn:task id="B13" name="Оформити рекламацію B" />
    <bpmn:task id="A15" name="Оновити залишки після поставки A" />
    <bpmn:task id="B15" name="Оновити залишки після поставки B" />
    <bpmn:endEvent id="A16" name="Залишки оновлено — A" />
    <bpmn:endEvent id="B16" name="Залишки оновлено — B" />
    <bpmn:sequenceFlow id="PF1" sourceRef="P1" targetRef="P3" />
    <bpmn:sequenceFlow id="PF2" sourceRef="P2" targetRef="P3" />
    <bpmn:sequenceFlow id="PF3" sourceRef="P3" targetRef="P4" />
    <bpmn:sequenceFlow id="PF4" sourceRef="P4" targetRef="P5" />
    <bpmn:sequenceFlow id="PF5" sourceRef="P5" targetRef="P6" />
    <bpmn:sequenceFlow id="PFA" name="A має позиції" sourceRef="P6" targetRef="A7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">A=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PFB" name="B має позиції" sourceRef="P6" targetRef="B7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">B=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AF7" sourceRef="A7" targetRef="A8" />
    <bpmn:sequenceFlow id="AF8" sourceRef="A8" targetRef="A9" />
    <bpmn:sequenceFlow id="AF9y" name="так" sourceRef="A9" targetRef="A10">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Aok=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AF10" sourceRef="A10" targetRef="A11" />
    <bpmn:sequenceFlow id="AF11" sourceRef="A11" targetRef="A12" />
    <bpmn:sequenceFlow id="AF12y" name="так" sourceRef="A12" targetRef="A13">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Adiff=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AF12n" name="ні" sourceRef="A12" targetRef="A14">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Adiff=false</bpmn:conditionExpression>
